<html xmlns="http://www.w3.org/1999/xhtml"
      xmlns:i18n="http://xml.zope.org/namespaces/i18n"
      xmlns:metal="http://xml.zope.org/namespaces/metal"
      xmlns:tal="http://xml.zope.org/namespaces/tal"
      lang="en"
      metal:use-macro="context/main_template/macros/master"
      xml:lang="en"
      i18n:domain="collective.dms.mailcontent"
>

  <body>
    <metal:main fill-slot="main">
      <h1 class="documentFirstHeading"
          tal:content="view/label | nothing"
      ></h1>

      <div id="content-core">
        <metal:ttlf use-macro="context/@@ploneform-macros/titlelessform">
          <metal:formtop fill-slot="formtop">
            <tal:abovecontent replace="structure provider:dms.abovecontent" />
          </metal:formtop>
          <metal:fields-slot fill-slot="fields">
            <tal:com define="
                       comment string:'Added to englobe fields by a div when only basic metadata are used';
                     " />
            <input name="fieldset"
                   type="hidden"
                   tal:define="
                     current_fieldset request/fieldset | python:None;
                   "
                   tal:condition="python:has_groups and enable_form_tabbing and current_fieldset is not None"
                   tal:attributes="
                     value current_fieldset;
                   "
            />
            <div id="all-fields"
                 style="float:left; width: 49%;"
                 tal:define="
                   show_default_label show_default_label|nothing;
                 "
                 tal:omit-tag="show_default_label"
            >
              <metal:fields use-macro="context/@@ploneform-macros/fields" />
            </div>
          </metal:fields-slot>
        </metal:ttlf>
      </div>
    </metal:main>
  </body>
</html>

