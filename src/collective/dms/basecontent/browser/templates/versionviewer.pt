<html xmlns="http://www.w3.org/1999/xhtml"
      xmlns:i18n="http://xml.zope.org/namespaces/i18n"
      xmlns:metal="http://xml.zope.org/namespaces/metal"
      xmlns:tal="http://xml.zope.org/namespaces/tal"
      lang="en"
      xml:lang="en"
      tal:omit-tag=""
      i18n:domain="collective.dms.mailcontent"
>

  <metal:content-core define-macro="content-core"
                      i18n:domain="collective.documentviewer"
  >
    <tal:notshow tal:condition="not: view/enabled">
      <dl id="errorMsg"
          tal:condition="python: view.can_modify and view.settings.successfully_converted is False"
      >
        <dt>
          <a href="#"
             i18n:ignore=""
          >Show Document Viewer Conversion Error</a>
        </dt>
        <dd>
          <pre tal:content="python: view.settings.exception_msg"></pre>
          <pre tal:content="python: view.settings.exception_traceback"></pre>
        </dd>
      </dl>
    </tal:notshow>
    <div class="pat-documentviewer DV-container"
         aria-hidden="true"
         data-pat-documentviewer="${view/pattern_options}"
    >
      <div class="DV-loadingDocument"><span i18n:translate="">Loading</span></div>
      <noscript>
        <div id="DV-noJS"
             style="height:500px"
             i18n:translate=""
        >The Document Viewer requires that you enable Javascript.</div>
      </noscript>
    </div>
  </metal:content-core>
</html>
