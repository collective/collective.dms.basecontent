<?xml version="1.0" encoding="utf-8"?>
<object xmlns:i18n="http://xml.zope.org/namespaces/i18n"
        meta_type="Plone Actions Tool"
        name="portal_actions"
>
  <object meta_type="CMF Action Category"
          name="object_buttons"
  >

    <object meta_type="CMF Action"
            name="external_edit"
            i18n:domain="collective.externaleditor"
    >
      <property name="title"
                i18n:translate=""
      >Edit with external application</property>
      <property name="description"
                i18n:translate=""
      />
      <property name="url_expr">string:${object_url}/@@external_edit</property>
      <property name="icon_expr">string:${portal_url}/++resource++imio.actionspanel/extedit_icon.png</property>
      <property name="available_expr">object/@@externalEditorEnabled/available</property>
      <property name="permissions">
        <element value="Modify portal content" />
      </property>
      <property name="visible">True</property>
    </object>

  </object>
</object>
