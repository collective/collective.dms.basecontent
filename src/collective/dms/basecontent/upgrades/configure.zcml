<configure
    xmlns="http://namespaces.zope.org/zope"
    xmlns:genericsetup="http://namespaces.zope.org/genericsetup"
    i18n_domain="collective.dms.basecontent"
    >

  <genericsetup:upgradeStep
      title="Migration profile for collective.dms.basecontent to 2"
      description="Upgrade from 1 to 2"
      profile="collective.dms.basecontent:default"
      source="0001"
      destination="2"
      handler=".upgrades.v2"
      />

  <genericsetup:upgradeStep
      title="Migration profile for collective.dms.basecontent to 3"
      description="Upgrade from 2 to 3"
      profile="collective.dms.basecontent:default"
      source="2"
      destination="3"
      handler=".upgrades.v3"
      />

  <genericsetup:upgradeStep
      title="Migration profile for collective.dms.basecontent to 4"
      description="Upgrade from 3 to 4"
      profile="collective.dms.basecontent:default"
      source="3"
      destination="4"
      handler=".upgrades.v4"
      />

</configure>
